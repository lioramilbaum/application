# Routes each hello-world-image architecture variant to its own tag during transfer.
# Without this file, the catch-all oci uploader in uploaders.ocmconfig pushes both variants
# to the same tag (last write wins). publish.sh loads this file before uploaders.ocmconfig,
# so this more specific entry matches first. Apply with: TRANSFER_CONFIG=transfer.ocmconfig
type: generic.config.ocm.software/v1
configurations:
  - type: oci.uploader.transfer.config.ocm.software/v1alpha1
    match: resource.name == "hello-world-image"
    imageReference: '${target.baseUrl + (target.subPath == "" ? "" : "/" + target.subPath) + "/" + resource.access.toOCI().repository + ":" + resource.access.toOCI().tag + "-" + resource.extraIdentity.architecture}'
