#!/usr/bin/env python3
# OCM plugin serving the demo-store/v1alpha1 access type (stdlib only, Python 3.9+).
#
# `capabilities` prints the access types this plugin serves. `--config <json>` serves
# them over a Unix socket: the socket URL is the only stdout line, logs go to stderr.
import base64
import datetime
import hashlib
import http.server
import json
import os
import shutil
import signal
import socketserver
import sys
import tempfile
import threading
import time

ACCESS_TYPE = "demo-store/v1alpha1"

SCHEMA = {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["type", "storeId", "blobId"],
    "properties": {
        "type": {"type": "string"},
        "storeId": {"type": "string"},
        "blobId": {"type": "string"},
    },
}


def log(msg):
    stamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
    print(json.dumps({"level": "DEBUG", "msg": msg, "time": stamp}), file=sys.stderr, flush=True)


def capabilities():
    if os.environ.get("DEMO_STORE_FAULT") == "capabilities":
        print("{not json", flush=True)
        return
    schema = base64.b64encode(json.dumps(SCHEMA).encode()).decode()
    access = [{"type": ACCESS_TYPE, "aliases": None, "jsonSchema": schema}]
    print(json.dumps({"capabilities": [
        {"type": "resourceRepository", "supportedAccessTypes": access},
        {"type": "digestProcessorRepository", "supportedAccessTypes": access},
    ]}, separators=(",", ":")), flush=True)


def presented_token(header):
    # OCM sends the resolved credentials as a JSON object; Basic and Bearer are accepted too.
    if not header:
        return None
    if header.startswith("Bearer "):
        return header[len("Bearer "):]
    try:
        if header.startswith("Basic "):
            user, _, password = base64.b64decode(header[len("Basic "):]).decode().partition(":")
            return password or user
        props = json.loads(header).get("properties") or {}
        return props.get("token") or props.get("password")
    except (ValueError, AttributeError):
        return None


def blob_bytes(blob):
    return blob["text"].encode()


class UnixHTTPServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True

    def __init__(self, sock_path, store, fault, private_dir):
        self.store = store
        self.fault = fault
        self.private_dir = private_dir
        self.last_request = time.monotonic()
        super().__init__(sock_path, PluginHandler)

    def server_bind(self):
        self.socket.bind(self.server_address)

    def get_request(self):
        # AF_UNIX peers have no address; give the handler a placeholder.
        request, _ = self.socket.accept()
        return request, ("plugin", 0)


class PluginHandler(http.server.BaseHTTPRequestHandler):
    def setup(self):
        super().setup()
        self.server.last_request = time.monotonic()

    def address_string(self):
        return "plugin"

    def log_message(self, fmt, *args):
        log(fmt % args)

    def reply(self, code, data, content_type="application/json"):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, code, obj):
        self.reply(code, json.dumps(obj).encode())

    def do_GET(self):
        if self.path == "/healthz":
            self.send_json(200, {"status": "ok"})
        else:
            self.send_json(404, {"error": "not found"})

    def do_POST(self):
        routes = {
            "/identity": self.identity,
            "/resource/get": self.resource_get,
            "/resource/digest/process": self.digest_process,
        }
        route = routes.get(self.path)
        if route is None:
            self.send_json(404, {"error": "not found"})
            return
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)))
            route(body)
        except (AttributeError, KeyError, TypeError, ValueError):
            self.send_json(400, {"error": "malformed request"})

    def identity(self, body):
        store_id = body["type"]["storeId"]
        self.send_json(200, {"identity": {"type": ACCESS_TYPE, "storeId": store_id}})

    def blob(self, access):
        # Replies with the error and returns None when the blob cannot be served.
        # The spec is checked before auth: OCM sends no credentials for a spec it cannot identify.
        blob_id = access.get("blobId")
        if not blob_id:
            self.send_json(400, {"error": "invalid access spec: blobId is required"})
            return None
        store = self.server.store["stores"].get(access["storeId"])
        if store is None:
            self.send_json(404, {"error": "unknown store"})
            return None
        if presented_token(self.headers.get("Authorization")) != store["token"]:
            self.send_json(401, {"error": "unauthorized"})
            return None
        blob = store["blobs"].get(blob_id)
        if blob is None:
            self.send_json(404, {"error": "unknown blob"})
        return blob

    def write_private(self, data):
        fd, path = tempfile.mkstemp(dir=self.server.private_dir, prefix="blob-")
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        return path

    def resource_get(self, body):
        blob = self.blob(body["resource"]["access"])
        if blob is None:
            return
        fault = self.server.fault
        if fault == "error":
            self.reply(500, b"demo-store: injected failure", "text/plain")
        elif fault == "garbage":
            self.reply(200, b"not json", "text/plain")
        elif fault == "remote-url":
            self.send_json(200, {"location": {"type": "remoteURL", "value": "http://example.com/blob"}})
        else:
            data = b"tampered\n" if fault == "tamper" else blob_bytes(blob)
            path = self.write_private(data)
            self.send_json(200, {"location": {"type": "localFile", "value": path, "mediaType": blob["mediaType"]}})

    def digest_process(self, body):
        resource = dict(body["resource"])
        blob = self.blob(resource["access"])
        if blob is None:
            return
        resource["digest"] = {
            "hashAlgorithm": "SHA-256",
            "normalisationAlgorithm": "genericBlobDigest/v1",
            "value": hashlib.sha256(blob_bytes(blob)).hexdigest(),
        }
        self.send_json(200, {"resource": resource})


def serve(config):
    store_path = os.environ.get("DEMO_STORE_FILE") or \
        os.path.join(os.path.dirname(os.path.realpath(__file__)), "demo-store.json")
    with open(store_path) as f:
        store = json.load(f)
    # /tmp, not TMPDIR: AF_UNIX paths are limited to 104 bytes on macOS.
    private_dir = tempfile.mkdtemp(prefix="ocm-demo-store-", dir="/tmp")
    stopped = threading.Event()
    server = None
    try:
        server = UnixHTTPServer(os.path.join(private_dir, "s.sock"), store,
                                os.environ.get("DEMO_STORE_FAULT", ""), private_dir)

        def stop(*_):
            if not stopped.is_set():
                stopped.set()
                # shutdown() blocks until serve_forever() returns, so it cannot run on the serving thread.
                threading.Thread(target=server.shutdown, daemon=True).start()

        idle_ns = config.get("idleTimeout", 0)
        parent = os.getppid()

        def watch():
            while not stopped.wait(0.5):
                if os.getppid() != parent:
                    stop()
                elif idle_ns and time.monotonic() - server.last_request > idle_ns / 1e9:
                    stop()

        signal.signal(signal.SIGINT, stop)
        signal.signal(signal.SIGTERM, stop)
        threading.Thread(target=watch, daemon=True).start()
        log("serving id=%s" % config.get("id", ""))
        print("http+unix://" + server.server_address, flush=True)
        server.serve_forever()
    finally:
        stopped.set()
        if server is not None:
            server.server_close()
        shutil.rmtree(private_dir, ignore_errors=True)


def main(argv):
    if argv[1:] == ["capabilities"]:
        capabilities()
        return 0
    if len(argv) == 3 and argv[1] == "--config":
        serve(json.loads(argv[2]))
        return 0
    print("usage: demo-store-plugin capabilities | --config <json>", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
