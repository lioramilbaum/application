{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>lioramilbaum/renovate-config"],
  "packageRules": [
    {
      "description": "OCM CLI bumps need a row in test/ocm-versions.tsv (docs/development.md#ocm-version-validation)",
      "matchDepNames": ["open-component-model/open-component-model"],
      "prBodyNotes": [
        "**OCM CLI bump:** the `ocm-version-validated` check stays red, and the version-specific tests SKIP, until `test/ocm-versions.tsv` has a row for the new version. Add the row in a separate PR, not on this branch. See docs/development.md#ocm-version-validation."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "ARG OCM_CLI_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "open-component-model/open-component-model",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "OCM CLI linux/amd64 SHA256 digest",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: ocm-linux-amd64 (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\nARG OCM_SHA256_LINUX_AMD64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "open-component-model/open-component-model",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "OCM CLI linux/arm64 SHA256 digest",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: ocm-linux-arm64 (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\nARG OCM_SHA256_LINUX_ARM64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "open-component-model/open-component-model",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "kind version in Dockerfile",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "ARG KIND_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "kind linux/amd64 SHA256 digest",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: kind-linux-amd64 (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\nARG KIND_SHA256_LINUX_AMD64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "kind linux/arm64 SHA256 digest",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: kind-linux-arm64 (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\nARG KIND_SHA256_LINUX_ARM64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "Helm version in devcontainer features",
      "managerFilePatterns": ["/^\\.devcontainer/devcontainer\\.json$/"],
      "matchStrings": ["\"helm\": \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Flux version in Dockerfile",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": ["ARG FLUX_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Flux CLI linux/amd64 SHA256 digest",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: flux-linux-amd64 (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\nARG FLUX_SHA256_LINUX_AMD64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "Flux CLI linux/arm64 SHA256 digest",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: flux-linux-arm64 (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\nARG FLUX_SHA256_LINUX_ARM64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "Flux version in controller.sh",
      "managerFilePatterns": ["/^scripts/controller\\.sh$/"],
      "matchStrings": ["FLUX_VERSION=\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "OCM Kubernetes controller chart version (OCI)",
      "managerFilePatterns": ["/^scripts/controller\\.sh$/"],
      "matchStrings": ["OCM_CONTROLLER_CHART_VERSION=\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "ghcr.io/open-component-model/kubernetes/controller/chart",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "kro chart version",
      "managerFilePatterns": ["/^scripts/controller\\.sh$/"],
      "matchStrings": ["KRO_CHART_VERSION=\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "kro-run/kro",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^component-constructor\\.yaml$/"],
      "matchStrings": [
        "imageReference: docker\\.io/library/nginx:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "depNameTemplate": "library/nginx",
      "datasourceTemplate": "docker"
    }
  ]
}
