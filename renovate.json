{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "separateMajorMinor": false,
  "packageRules": [
    {
      "description": "Bump OCM CLI version and both linux SHA256 pins in one PR",
      "matchDepNames": ["open-component-model/open-component-model"],
      "groupName": "OCM CLI"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "ARG OCM_CLI_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "open-component-model/open-component-model",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "OCM CLI linux/amd64 SHA256 digest",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: ocm-linux-amd64 (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\nARG OCM_SHA256_LINUX_AMD64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "open-component-model/open-component-model",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "OCM CLI linux/arm64 SHA256 digest",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: ocm-linux-arm64 (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\nARG OCM_SHA256_LINUX_ARM64=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "open-component-model/open-component-model",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "ARG KIND_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^component-constructor\\.yaml$/"],
      "matchStrings": [
        "imageReference: docker\\.io/library/nginx:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "library/nginx",
      "datasourceTemplate": "docker"
    }
  ]
}
